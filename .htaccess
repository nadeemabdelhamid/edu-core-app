Options -Indexes
ServerSignature Off

# ── Error pages ───────────────────────────────────────────
ErrorDocument 403 /educore/errors/403.php
ErrorDocument 404 /educore/errors/404.php
ErrorDocument 500 /educore/errors/500.php

# ── Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    # Content-Security-Policy: allows YouTube/Vimeo embeds, self for all else
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.youtube.com https://i.vimeocdn.com; frame-src https://www.youtube.com https://player.vimeo.com; font-src 'self' data:; connect-src 'self';" 
</IfModule>

# ── Block access to sensitive files ──────────────────────
<FilesMatch "\.(sql|log|env|ini|md|sh|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block access to hidden files/dirs (.git, etc.) ───────
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── PHP execution is allowed globally (handled by Apache defaults) ──────
# To block PHP in specific dirs (e.g. uploads), add a .htaccess there.

# ── Disable server-side includes ─────────────────────────
Options -Includes

# ── PHP settings (XAMPP may ignore some) ─────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>
