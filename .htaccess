Options -Indexes
ServerSignature Off

# ── Error pages ───────────────────────────────────────────
ErrorDocument 403 /educore/errors/403.php
ErrorDocument 404 /educore/errors/404.php
ErrorDocument 500 /educore/errors/500.php

# ── Security headers ──────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# ── Block access to sensitive files ──────────────────────
<FilesMatch "\.(sql|log|env|ini|md|sh|bak)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Block access to hidden files/dirs (.git, etc.) ───────
<FilesMatch "^\.">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# ── Prevent PHP execution in uploads (if you add one) ────
<FilesMatch "\.php$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

# ── Disable server-side includes ─────────────────────────
Options -Includes

# ── PHP settings (XAMPP may ignore some) ─────────────────
<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value session.cookie_httponly 1
    php_value session.cookie_samesite Lax
    php_value session.use_strict_mode 1
</IfModule>
